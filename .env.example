# ══════════════════════════════════════════════════════════════════════════
#  GLOBE TROTTER VAL DE FONTENAY — variables d'environnement
#  Copiez ce fichier en `.env` puis renseignez les valeurs.
#  Le fichier `.env` ne doit JAMAIS être versionné (il est dans .gitignore).
# ══════════════════════════════════════════════════════════════════════════

# ─── Base de données ──────────────────────────────────────────────────────
# Développement local (SQLite, aucun serveur à installer) :
DATABASE_URL="file:./dev.db"
#
# Production — PostgreSQL (Neon, Supabase, Railway, VPS…) :
#   1. remplacez la ligne ci-dessus par votre URL :
#      DATABASE_URL="postgresql://user:motdepasse@hote:5432/globetrotter?sslmode=require"
#   2. dans prisma/schema.prisma, passez `provider = "sqlite"` à "postgresql"
#   3. exécutez `npx prisma db push`
# Aucun autre fichier n'est à modifier.

# ─── Sécurité ─────────────────────────────────────────────────────────────
# Clé de signature des sessions d'administration. 32 caractères minimum.
# Générez-en une avec :  npm run admin:hash
AUTH_SECRET="remplacez-par-une-chaine-aleatoire-de-64-caracteres-minimum-svp"

# ─── Compte administrateur ────────────────────────────────────────────────
# Utilisés uniquement par `npm run db:seed`, qui crée ou met à jour le compte.
# Le mot de passe n'est jamais stocké en clair : seul son condensat bcrypt
# est enregistré en base.
ADMIN_EMAIL="contact@exemple.fr"
ADMIN_PASSWORD="choisissez-un-mot-de-passe-long-et-unique"
ADMIN_NAME="Globe Trotter Val de Fontenay"

# ─── Site ─────────────────────────────────────────────────────────────────
# URL canonique publique, sans barre oblique finale.
# Sert aux balises Open Graph, au sitemap et aux données structurées.
NEXT_PUBLIC_SITE_URL="https://www.exemple.fr"

# Adresse de contact affichée publiquement (facultatif).
# NEXT_PUBLIC_CONTACT_EMAIL="contact@exemple.fr"
